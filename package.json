{
  "name": "protvista-uniprot",
  "description": "ProtVista tool for the UniProt website",
  "version": "5.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "yarn build",
    "prepublishOnly": "yarn test:pack",
    "build": "vite build",
    "start": "yarn docs:dev",
    "docs:dev": "astro dev --root docs",
    "docs:build": "astro build --root docs",
    "site:build": "yarn docs:build && yarn bench:build",
    "site:preview": "astro preview --root docs",
    "schema:sync": "node scripts/sync-schema.mjs",
    "adapters:sync": "UPDATE_ADAPTER_REFERENCE=1 vitest run src/schema/__spec__/adapter-reference-publishing.spec.ts",
    "test": "npm-run-all --continue-on-error test:lint test:types test:unit test:browser",
    "test:pack": "yarn build && publint --strict --pack npm && attw --pack . --ignore-rules cjs-resolves-to-esm",
    "validate": "./scripts/validate-package.sh",
    "test:lint": "eslint 'src/**/*.ts' 'bench/**/*.{mjs,cjs}'",
    "test:types": "tsc",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "node bench/run.mjs",
    "bench:build": "vite build --config vite.bench.config.mjs",
    "bench:bundle": "yarn build && node bench/bundle-size.mjs",
    "bench:lighthouse": "yarn bench:build && lhci autorun --config=bench/lighthouserc.cjs",
    "bench:summary": "node bench/summarize.mjs",
    "cdn:clear": "./scripts/clearCDNcaches.sh"
  },
  "module": "dist/protvista-uniprot.mjs",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/protvista-uniprot.mjs",
      "default": "./dist/protvista-uniprot.mjs"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "protvista",
    "uniprot",
    "protein",
    "bioinformatics",
    "sequence-viewer",
    "genome-browser",
    "web-components",
    "custom-elements",
    "lit",
    "visualization"
  ],
  "author": "Xavier Watkins <xwatkins@ebi.ac.uk>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ebi-webcomponents/protvista.git"
  },
  "bugs": {
    "url": "https://github.com/ebi-webcomponents/protvista/issues"
  },
  "homepage": "https://ebi-webcomponents.github.io/protvista",
  "publishConfig": {
    "tag": "next"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@markdoc/markdoc": "^0.5.8",
    "@nightingale-elements/nightingale-colored-sequence": "^5.6.0",
    "@nightingale-elements/nightingale-filter": "^5.6.0",
    "@nightingale-elements/nightingale-linegraph-track": "^5.6.0",
    "@nightingale-elements/nightingale-manager": "^5.6.0",
    "@nightingale-elements/nightingale-navigation": "^5.6.0",
    "@nightingale-elements/nightingale-sequence": "^5.6.0",
    "@nightingale-elements/nightingale-sequence-heatmap": "^5.6.2",
    "@nightingale-elements/nightingale-structure": "^5.10.3",
    "@nightingale-elements/nightingale-track-canvas": "^5.6.0",
    "@nightingale-elements/nightingale-variation-canvas": "^5.10.1",
    "ajv": "^8.20.0",
    "color-hash": "^2.0.2",
    "js-yaml": "^4.3.0",
    "lit": "^3.3.3",
    "timing-functions": "^2.0.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@astrojs/starlight": "^0.41.4",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.1",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@originjs/vite-plugin-commonjs": "1.0.3",
    "@types/color-hash": "2.0.0",
    "@types/js-yaml": "4.0.9",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@vitest/browser": "4.1.5",
    "@vitest/browser-playwright": "4.1.5",
    "@vitest/coverage-v8": "4.1.5",
    "astro": "^7.1.3",
    "astro-mermaid": "^2.1.0",
    "axe-core": "4.12.1",
    "codemirror": "6.0.2",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "mermaid": "11.16.0",
    "npm-run-all": "4.1.5",
    "playwright": "1.61.1",
    "publint": "0.3.16",
    "rollup-plugin-visualizer": "7.0.1",
    "sharp": "^0.35.3",
    "svg-inline-loader": "0.8.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.0.10",
    "vite-plugin-dts": "5.0.3",
    "vite-plugin-env-compatible": "2.0.1",
    "vite-plugin-html": "3.2.2",
    "vite-plugin-svgo": "2.0.0",
    "vitest": "4.1.5"
  },
  "browserslist": [
    "chrome >= 92",
    "edge >= 92",
    "firefox >= 90",
    "safari >= 15"
  ]
}
