{
  "name": "protvista-uniprot",
  "description": "ProtVista tool for the UniProt website",
  "version": "5.0.0-beta.5",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm test:pack",
    "build": "vite build",
    "start": "pnpm docs:dev",
    "docs:dev": "astro dev --root docs",
    "docs:build": "astro build --root docs",
    "site:build": "pnpm docs:build && pnpm bench:build",
    "site:preview": "astro preview --root docs",
    "schema:sync": "node scripts/sync-schema.mjs",
    "adapters:sync": "UPDATE_ADAPTER_REFERENCE=1 vitest run src/schema/__spec__/adapter-reference-publishing.spec.ts",
    "vocabulary:sync": "UPDATE_FEATURE_VOCABULARY=1 vitest run src/schema/__spec__/feature-vocabulary-publishing.spec.ts",
    "test": "npm-run-all --continue-on-error test:lint test:types test:unit test:browser",
    "test:pack": "pnpm build && publint --strict --pack npm && attw --pack . --ignore-rules cjs-resolves-to-esm",
    "validate": "./scripts/validate-package.sh",
    "release:next": "./scripts/release-next.sh",
    "test:lint": "eslint \"src/**/*.ts\" \"bench/**/*.{mjs,cjs}\" \"scripts/conservation/**/*.mjs\" \"scripts/complexity/**/*.mjs\"",
    "test:types": "tsc",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:palettes": "python3 scripts/accessibility/test_palette_audit.py",
    "bench": "node bench/run.mjs",
    "bench:build": "vite build --config vite.bench.config.mjs",
    "bench:bundle": "pnpm build && node bench/bundle-size.mjs",
    "bench:lighthouse": "pnpm bench:build && lhci autorun --config=bench/lighthouserc.cjs",
    "bench:summary": "node bench/summarize.mjs",
    "metrics:complexity": "node scripts/complexity/measure.mjs",
    "cdn:clear": "./scripts/clearCDNcaches.sh",
    "screenshots": "node scripts/screenshots/capture.mjs",
    "screenshots:check": "node scripts/screenshots/capture.mjs --check"
  },
  "module": "dist/protvista-uniprot.mjs",
  "types": "dist/types/index.d.ts",
  "typesVersions": {
    "*": {
      "config": [
        "./dist/types/config.d.ts"
      ],
      "structure": [
        "./dist/types/structure.d.ts"
      ],
      "react": [
        "./dist/types/react.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/protvista-uniprot.mjs",
      "default": "./dist/protvista-uniprot.mjs"
    },
    "./config": {
      "types": "./dist/types/config.d.ts",
      "import": "./dist/config.mjs",
      "default": "./dist/config.mjs"
    },
    "./structure": {
      "types": "./dist/types/structure.d.ts",
      "import": "./dist/structure.mjs",
      "default": "./dist/structure.mjs"
    },
    "./react": {
      "types": "./dist/types/react.d.ts"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "protvista",
    "uniprot",
    "protein",
    "bioinformatics",
    "sequence-viewer",
    "genome-browser",
    "web-components",
    "custom-elements",
    "lit",
    "visualization"
  ],
  "author": "Xavier Watkins <xwatkins@ebi.ac.uk>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ebi-webcomponents/protvista.git"
  },
  "bugs": {
    "url": "https://github.com/ebi-webcomponents/protvista/issues"
  },
  "homepage": "https://ebi-webcomponents.github.io/protvista",
  "publishConfig": {
    "tag": "beta"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@markdoc/markdoc": "^0.5.10",
    "@nightingale-elements/nightingale-colored-sequence": "^5.11.0",
    "@nightingale-elements/nightingale-filter": "^5.11.0",
    "@nightingale-elements/nightingale-linegraph-track": "^5.11.0",
    "@nightingale-elements/nightingale-manager": "^5.11.0",
    "@nightingale-elements/nightingale-navigation": "^5.11.0",
    "@nightingale-elements/nightingale-sequence": "^5.11.0",
    "@nightingale-elements/nightingale-sequence-heatmap": "^5.11.0",
    "@nightingale-elements/nightingale-structure": "^5.11.0",
    "@nightingale-elements/nightingale-track-canvas": "^5.11.1",
    "@nightingale-elements/nightingale-variation-canvas": "^5.11.1",
    "ajv": "^8.20.0",
    "color-hash": "^2.0.2",
    "js-yaml": "^4.3.2",
    "lit": "^3.3.3",
    "timing-functions": "^2.0.1"
  },
  "peerDependencies": {
    "@types/react": ">=19"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@astrojs/starlight": "^0.42.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@originjs/vite-plugin-commonjs": "1.0.3",
    "@types/color-hash": "2.0.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "@vitest/browser": "5.0.3",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "astro": "^7.3.5",
    "astro-mermaid": "^2.1.0",
    "axe-core": "4.13.0",
    "codemirror": "6.0.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "mermaid": "12.0.0",
    "npm-run-all": "4.1.5",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "publint": "0.3.24",
    "rollup-plugin-visualizer": "7.1.1",
    "sharp": "^0.35.5",
    "starlight-links-validator": "0.26.0",
    "starlight-llms-txt": "0.12.0",
    "svg-inline-loader": "0.8.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vite-plugin-dts": "5.1.1",
    "vite-plugin-env-compatible": "2.0.1",
    "vite-plugin-html": "3.2.2",
    "vite-plugin-svgo": "3.0.1",
    "vitest": "5.0.3"
  },
  "browserslist": [
    "chrome >= 92",
    "edge >= 92",
    "firefox >= 90",
    "safari >= 15"
  ]
}
