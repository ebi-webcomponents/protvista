{
  "name": "protvista-uniprot",
  "description": "ProtVista tool for the UniProt website",
  "version": "5.0.0",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build:es": "tsc --emitDeclarationOnly",
    "build": "vite build",
    "build:demo": "vite build --config vite.demo.config.mjs",
    "preview:demo": "vite preview --config vite.demo.config.mjs",
    "schema:sync": "node scripts/sync-schema.mjs",
    "start": "vite --config vite.demo.config.mjs",
    "test:lint": "eslint 'src/**/*.ts' 'bench/**/*.{mjs,cjs}'",
    "test:types": "tsc",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test": "npm-run-all --continue-on-error test:lint test:types test:unit",
    "bench": "node bench/run.mjs",
    "bench:bundle": "yarn build && node bench/bundle-size.mjs",
    "bench:lighthouse": "yarn build:demo && lhci autorun --config=bench/lighthouserc.cjs",
    "bench:summary": "node bench/summarize.mjs",
    "clear-cdn-cache": "./scripts/clearCDNcaches.sh"
  },
  "main": "dist/protvista-uniprot.js",
  "module": "dist/protvista-uniprot.mjs",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/protvista-uniprot.mjs"
    }
  },
  "sideEffects": false,
  "keywords": [],
  "author": "Xavier Watkins &lt;xwatkins@ebi.ac.uk&gt;",
  "license": "MIT",
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "@markdoc/markdoc": "0.5.8",
    "@nightingale-elements/nightingale-colored-sequence": "5.6.0",
    "@nightingale-elements/nightingale-filter": "5.6.0",
    "@nightingale-elements/nightingale-linegraph-track": "5.6.0",
    "@nightingale-elements/nightingale-manager": "5.6.0",
    "@nightingale-elements/nightingale-navigation": "5.6.0",
    "@nightingale-elements/nightingale-sequence": "5.6.0",
    "@nightingale-elements/nightingale-sequence-heatmap": "5.6.2",
    "@nightingale-elements/nightingale-structure": "5.10.3",
    "@nightingale-elements/nightingale-track-canvas": "5.6.0",
    "@nightingale-elements/nightingale-variation-canvas": "5.10.1",
    "ajv": "8.20.0",
    "color-hash": "2.0.2",
    "core-js": "3.49.0",
    "js-yaml": "5.2.1",
    "lit": "3.3.3",
    "lodash-es": "4.18.1",
    "timing-functions": "2.0.1"
  },
  "devDependencies": {
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.1",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@originjs/vite-plugin-commonjs": "1.0.3",
    "@types/color-hash": "2.0.0",
    "@types/js-yaml": "4.0.9",
    "@types/lodash-es": "4.17.12",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@vitest/coverage-v8": "4.1.5",
    "codemirror": "6.0.2",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "npm-run-all": "4.1.5",
    "rollup-plugin-visualizer": "7.0.1",
    "svg-inline-loader": "0.8.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.0.10",
    "vite-plugin-dts": "5.0.3",
    "vite-plugin-env-compatible": "2.0.1",
    "vite-plugin-html": "3.2.2",
    "vite-plugin-svgo": "2.0.0",
    "vitest": "4.1.5"
  },
  "browserslist": [
    "chrome >= 92",
    "edge >= 92",
    "firefox >= 90",
    "safari >= 15"
  ]
}
