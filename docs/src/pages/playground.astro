---
// Native, full-screen configuration playground (a plain Astro page, NOT a
// Starlight doc — no nav/sidebar chrome). The markup is server-rendered; the
// heavy bits (the <protvista-uniprot> component + the playground controller)
// load only on the client via the script tag at the bottom, so nothing renders
// server-side. Replaces the standalone playground.html + vite.playground.config
// build — this page is built by `astro build` alongside the docs.
import { readFileSync } from 'node:fs';

// Which version this playground runs. It is built from the repo source, so it
// exercises whatever `package.json` says — currently a v5 pre-release, while
// `npm install protvista-uniprot` still resolves the 4.x line. Not a Starlight
// page, so it cannot inherit the docs' version banner (see
// src/components/VersionBanner.astro); it shows the version in the header bar
// instead, read from the manifest so a release bump carries it automatically.
const { version } = JSON.parse(
  readFileSync(new URL('../../../package.json', import.meta.url), 'utf8')
) as { version: string };

// Same treatment as the docs chip (src/components/SocialIcons.astro): filled
// while this is a pre-release, outlined once it is not, so it quietens down by
// itself at 5.0.0. Keep the two in step — they are the same statement in two
// places, and a reader moving between them should see one thing, not two.
const isPrerelease = version.includes('-');
const versionTooltip = isPrerelease
  ? `This playground runs ProtVista ${version}, a beta pre-release. ` +
    `npm install protvista-uniprot still gives the stable 4.x line; ` +
    `install this one with npm install protvista-uniprot@beta.`
  : `This playground runs ProtVista ${version}.`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>ProtVista configuration playground</title>
    <meta
      name="description"
      content="Edit a ProtVista YAML/JSON config with live validation and a live viewer preview. Share your setup with a link."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <header class="bar">
      <a class="home" href="/protvista/">← Docs</a>
      <h1>Configuration playground</h1>
      <a
        class:list={['version', { 'is-prerelease': isPrerelease }]}
        href="/protvista/blog/protvista-5"
        title={versionTooltip}>v{version}</a
      >

      <div class="field">
        <label for="preset">Preset</label>
        <select id="preset" aria-label="Configuration preset"></select>
      </div>

      <div class="field">
        <label for="accession">Accession</label>
        <input
          id="accession"
          type="text"
          value="P05067"
          spellcheck="false"
          autocomplete="off"
        />
      </div>

      <div class="field local-data">
        <button id="load-data" type="button" aria-describedby="local-note">
          Load data file…
        </button>
        <!-- No accept=: a file with any extension can be picked. A FASTA
             file (by extension, or a '>' first line) sets the config's
             sequence:; any other file opens the attach form, which asks
             how to read it. -->
        <input id="data-file" type="file" hidden />
        <span id="local-note" class="local-note"
          >Read in your browser — never uploaded. Only the file name goes into
          the config.</span
        >
      </div>

      <div class="field share-export">
        <button id="copy-link" type="button" title="Copy a shareable link to this setup">
          Copy link
        </button>
        <button
          id="download-config"
          type="button"
          title="Download the editor text as config.json or config.yaml"
        >
          Download config
        </button>
        <span id="share-status" role="status" aria-live="polite"></span>
      </div>

      <button id="run" type="button" title="Update the preview (Ctrl/Cmd+Enter)">
        <span aria-hidden="true">▶</span> Run
      </button>
    </header>
    <p id="preset-desc" class="preset-desc" aria-live="polite"></p>

    <main id="panels">
      <section id="config-pane" class="pane" aria-label="Config editor">
        <h2>Config (YAML or JSON)</h2>
        <div class="local-files">
          <div id="data-attach" hidden></div>
          <p id="data-status" role="status" aria-live="polite"></p>
          <pre id="data-snippet" hidden></pre>
          <ul id="data-files" aria-label="Loaded data files" hidden></ul>
        </div>
        <div id="editor"></div>
        <div id="drop-overlay" class="drop-overlay" hidden>
          <p>
            Drop to load the file — read in your browser, never uploaded. Only
            its name goes into the config.
          </p>
        </div>
        <div
          class="errors"
          role="region"
          aria-label="Validation results"
          aria-live="polite"
        >
          <p id="error-summary">Loading…</p>
          <ul id="errors"></ul>
        </div>
      </section>

      <div
        class="splitter"
        id="splitter"
        role="separator"
        aria-orientation="vertical"
        aria-label="Resize panels"
        aria-valuemin="15"
        aria-valuemax="85"
        aria-valuenow="50"
        tabindex="0"
      ></div>

      <section class="pane" aria-label="Live preview">
        <h2>Preview</h2>
        <p id="preview-stale" role="status" hidden>
          <span aria-hidden="true">▶</span> Preview is out of date — press
          <strong>Run</strong> (Ctrl/Cmd+Enter) to update it. Fix any errors
          listed on the left first.
        </p>
        <div id="preview"></div>
      </section>
    </main>

    <!-- Client-only: runs the playground controller, which itself imports
         and registers <protvista-uniprot>. Imported from the library source
         at the repo root (see fs.allow in astro.config.mjs); Astro bundles
         this as a client script. The explicit component import is therefore
         redundant, but keeps this page's registration greppable. -->
    <script>
      import '../../../src/protvista-uniprot';
      import '../../../src/playground/index';
    </script>

    <style is:global>
      :root {
        --ink: #1a1a2e;
        --muted: #55566a;
        --accent: #0b6bcb;
        --line: #e2e4ee;
        --bg: #f7f8fc;
        --err: #b3261e;
      }
      * {
        box-sizing: border-box;
      }
      body {
        font-family: 'Open Sans', system-ui, sans-serif;
        color: var(--ink);
        background: var(--bg);
        margin: 0;
        display: flex;
        flex-direction: column;
        height: 100vh;
        height: 100dvh;
        overflow: hidden;
      }
      header.bar {
        flex: none;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem 1.25rem;
        padding: 0.75rem 1.25rem;
        border-bottom: 1px solid var(--line);
        background: #fff;
      }
      header.bar h1 {
        font-size: 1.1rem;
        margin: 0;
        margin-right: auto;
      }
      header.bar a.home {
        color: var(--accent);
        text-decoration: none;
        font-size: 0.9rem;
      }
      /* Version chip: states which release the playground runs. This page is
         outside Starlight, so it cannot use the docs chip component — the
         styling mirrors it deliberately (src/components/SocialIcons.astro). */
      header.bar a.version {
        display: inline-flex;
        align-items: center;
        color: var(--accent);
        text-decoration: none;
        font-size: 0.75rem;
        font-variant-numeric: tabular-nums;
        line-height: 1;
        white-space: nowrap;
        border: 1px solid currentColor;
        border-radius: 999px;
        padding: 0.25em 0.6em;
      }
      header.bar a.version:hover,
      header.bar a.version:focus-visible {
        color: #06427f;
      }
      /* A pre-release is the case worth noticing, so give it the accent fill. */
      header.bar a.version.is-prerelease {
        background-color: var(--accent);
        color: #fff;
        border-color: transparent;
      }
      header.bar a.version.is-prerelease:hover,
      header.bar a.version.is-prerelease:focus-visible {
        color: #fff;
        opacity: 0.85;
      }
      /* A <select> is as wide as its longest option, and a flex item will not
         shrink below its content, so on a phone the preset picker pushed the
         page sideways. min-width: 0 lets the field, then the select, shrink to
         the header line; where there is room nothing changes. */
      .field {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.9rem;
        min-width: 0;
      }
      .field select {
        min-width: 0;
      }
      .field label {
        color: var(--muted);
      }
      select,
      input,
      button {
        font: inherit;
        font-size: 0.9rem;
        padding: 0.35rem 0.55rem;
        border: 1px solid var(--line);
        border-radius: 0.35rem;
        background: #fff;
        color: inherit;
      }
      input#accession {
        width: 7rem;
      }
      input#accession:disabled {
        opacity: 0.6;
      }
      /* Added by the controller while the config sets `sequence:`. */
      .accession-hint {
        font-size: 0.8rem;
        color: var(--muted);
      }
      button#run {
        cursor: pointer;
        font-weight: 700;
        color: #fff;
        background: var(--accent);
        border-color: var(--accent);
      }
      button#run:hover {
        filter: brightness(1.08);
      }
      button {
        cursor: pointer;
      }
      .local-note {
        color: var(--muted);
        font-size: 0.8rem;
      }
      /* Loaded files, the attach form and its status: a strip above the
         editor that takes no room until something is in it. */
      .local-files {
        flex: none;
        background: #fff;
        font-size: 0.85rem;
      }
      .local-files > * {
        margin: 0;
        padding: 0.4rem 1rem;
        border-bottom: 1px solid var(--line);
      }
      .local-files > [hidden] {
        display: none;
      }
      /* An empty status line collapses but stays rendered: a live region that
         is display:none when its text arrives is not reliably announced. */
      .local-files > :empty {
        padding: 0;
        border: 0;
      }
      #data-snippet {
        font-size: 0.8rem;
        white-space: pre-wrap;
        background: var(--bg);
      }
      #data-files {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem 1rem;
      }
      #data-files li {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        min-width: 0;
        max-width: 100%;
      }
      /* A long file name with no spaces wraps rather than scrolling the page
         sideways on a phone. */
      #data-status,
      #data-files li span {
        min-width: 0;
        overflow-wrap: anywhere;
      }
      #data-files button,
      .data-attach button {
        font-size: 0.8rem;
        padding: 0.15rem 0.5rem;
      }
      .data-attach fieldset {
        border: none;
        margin: 0;
        padding: 0;
        /* A fieldset's min-width defaults to its content's, which a long
           file name in the legend would push past a phone's width. */
        min-width: 0;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem 1rem;
      }
      .data-attach legend {
        font-weight: 700;
        padding: 0 0 0.3rem;
        max-width: 100%;
        overflow-wrap: anywhere;
      }
      .data-attach-note {
        flex-basis: 100%;
        margin: 0;
        color: var(--muted);
      }
      .data-attach .actions {
        display: flex;
        gap: 0.5rem;
      }
      /* The "use as sequence" form: a column of radios, each with the list
         of what it changes. Without these, the nested fieldset would take
         the flex-row rules above and wrap badly on a phone. */
      .data-attach .sequence-targets {
        display: block;
        flex-basis: 100%;
        min-width: 0;
      }
      .data-attach .sequence-targets legend {
        font-weight: 600;
      }
      .sequence-target {
        display: grid;
        grid-template-columns: auto 1fr;
        align-items: baseline;
        column-gap: 0.4rem;
        margin: 0.3rem 0;
      }
      .sequence-target label {
        font-weight: 600;
      }
      .sequence-consequences {
        grid-column: 2;
        margin: 0.1rem 0 0;
        padding-left: 1.1rem;
        color: var(--muted);
        overflow-wrap: anywhere;
      }
      .sequence-target input:disabled + label {
        color: var(--muted);
      }
      .sequence-summary {
        flex-basis: 100%;
        margin: 0;
        overflow-wrap: anywhere;
      }
      .data-attach button[type='submit'] {
        font-weight: 700;
        color: #fff;
        background: var(--accent);
        border-color: var(--accent);
      }
      #config-pane {
        position: relative;
      }
      /* Over the pane while a file is dragged onto it. Ignores the pointer, so
         the drop lands on the pane underneath (which owns the drop). */
      .drop-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        text-align: center;
        font-weight: 700;
        color: var(--accent);
        background: rgb(255 255 255 / 0.9);
        border: 3px dashed var(--accent);
        pointer-events: none;
      }
      .drop-overlay[hidden] {
        display: none;
      }
      :focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 1px;
      }
      main {
        flex: 1 1 auto;
        min-height: 0;
        display: grid;
        grid-template-columns: var(--left, 1fr) 8px var(--right, 1fr);
        background: var(--bg);
      }
      main.dragging {
        cursor: col-resize;
        -webkit-user-select: none;
        user-select: none;
      }
      .splitter {
        background: var(--line);
        cursor: col-resize;
        touch-action: none;
      }
      .splitter:hover,
      .splitter:focus-visible {
        background: var(--accent);
        outline: none;
      }
      section.pane {
        background: var(--bg);
        display: flex;
        flex-direction: column;
        min-width: 0;
        min-height: 0;
        overflow: hidden;
      }
      .pane h2 {
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--muted);
        margin: 0;
        padding: 0.6rem 1rem;
        border-bottom: 1px solid var(--line);
        background: #fff;
      }
      #editor {
        flex: 1;
        min-height: 0;
        overflow: auto;
        background: #fff;
      }
      .cm-editor {
        height: 100%;
      }
      #preview {
        flex: 1;
        min-height: 0;
        overflow: auto;
        padding: 0.5rem 1rem 2rem;
        background: #fff;
      }
      #preview.stale {
        opacity: 0.55;
      }
      #preview-stale {
        flex: none;
        margin: 0;
        padding: 0.5rem 1rem;
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--err);
        background: #fff;
        border-bottom: 1px solid var(--line);
      }
      #preview-stale[hidden] {
        display: none;
      }
      .errors {
        flex: none;
        border-top: 1px solid var(--line);
        background: #fff;
        padding: 0.5rem 1rem;
      }
      #error-summary {
        font-size: 0.85rem;
        font-weight: 700;
        margin: 0;
      }
      #errors {
        margin: 0.35rem 0 0;
        padding-left: 1.1rem;
        font-size: 0.85rem;
        color: var(--err);
        max-height: 9rem;
        overflow: auto;
      }
      #errors:empty {
        display: none;
      }
      #errors li {
        margin: 0.15rem 0;
      }
      /* A warning names something legal — an explicit `format:` overriding a
         file's extension — so it must not read as a failure. */
      #errors li[data-severity='warning'] {
        color: var(--muted);
      }
      .preset-desc {
        flex: none;
        margin: 0;
        padding: 0.4rem 1.25rem;
        font-size: 0.85rem;
        color: var(--muted);
        background: #fff;
        border-bottom: 1px solid var(--line);
      }
      .preset-desc:empty {
        display: none;
      }
      @media (max-width: 760px) {
        body {
          height: auto;
          overflow: visible;
        }
        main {
          grid-template-columns: 1fr;
        }
        .splitter {
          display: none;
        }
        section.pane {
          overflow: visible;
        }
        #editor,
        #preview {
          height: 60vh;
        }
      }
    </style>
  </body>
</html>
